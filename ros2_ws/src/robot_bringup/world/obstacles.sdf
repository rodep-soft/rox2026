<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacle_world">
    <physics name="0.1ms" type="ignored">
      <max_step_size>0.0001</max_step_size> <!-- Ultra-high precision for stable slip -->
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles and Ramps -->
    <model name="ramp_15"><pose>3.0 1.5 0.13 0 -0.26 0</pose><static>true</static><link name="l"><collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry><material><diffuse>0.4 0.6 0.4 1</diffuse></material></visual></link></model>
    <model name="ramp_25"><pose>3.0 -1.5 0.21 0 -0.44 0</pose><static>true</static><link name="l"><collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry><material><diffuse>0.6 0.4 0.4 1</diffuse></material></visual></link></model>

    <model name="big_wall">
      <pose>5.0 0 0.5 0 0 0</pose><static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 10.0 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 10.0 2.0</size></box></geometry><material><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
