<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rox2026">
  <xacro:property name="body_length" value="0.47"/>
  <xacro:property name="body_width" value="0.41"/>
  <xacro:property name="body_height" value="0.16"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.08"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="blue"><color rgba="0.1 0.3 0.8 1"/></material></visual>
    <collision><origin xyz="0 0 0.08"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 0.08"/><mass value="20.0"/><inertia ixx="0.35" ixy="0" ixz="0" iyy="0.42" iyz="0" izz="0.65"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}"><visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"><color rgba="0.05 0.05 0.05 1"/></material></visual></link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} ${wheel_radius}" rpy="1.5708 0 0"/></joint>
  </xacro:macro>
  <xacro:wheel name="front_left_wheel" x="0.18" y="0.22"/>
  <xacro:wheel name="front_right_wheel" x="0.18" y="-0.22"/>
  <xacro:wheel name="rear_left_wheel" x="-0.18" y="0.22"/>
  <xacro:wheel name="rear_right_wheel" x="-0.18" y="-0.22"/>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.12"/></joint>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.18 0 0.22" rpy="0 0 0"/></joint>
</robot>