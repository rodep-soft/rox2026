+    DMA1_Channel3->CCR |= DMA_CCR_EN;
+    TIM3->DIER |= TIM_DIER_UDE;
+    TIM3->CNT = 0U;
+    TIM3->CR1 |= TIM_CR1_CEN;
+#endif
