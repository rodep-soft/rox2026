+static void LED_ConfigureTim3BurstDma(void) {
+    DMA1_Channel3->CCR &= ~DMA_CCR_EN;
+    DMA1_Channel3->CNDTR = TIM3_DMA_COUNT;
+    DMA1_Channel3->CPAR = (uint32_t)&TIM3->DMAR;
+    DMA1_Channel3->CMAR = (uint32_t)tim3PwmData;
+    DMA1_Channel3->CCR = DMA_CCR_DIR | DMA_CCR_MINC |
+            DMA_CCR_PSIZE_0 | DMA_CCR_MSIZE_0 | DMA_CCR_PL_1;
+}
+
 static void LED_StopTransfer(void) {
+    TIM3->DIER &= ~TIM_DIER_UDE;
     TIM17->DIER &= ~TIM_DIER_CC1DE;
+    TIM3->CR1 &= ~TIM_CR1_CEN;
     TIM17->CR1 &= ~TIM_CR1_CEN;
+    DMA1_Channel3->CCR &= ~DMA_CCR_EN;
     DMA1_Channel1->CCR &= ~DMA_CCR_EN;
+    TIM3->CCR1 = 0U;
+    TIM3->CCR2 = 0U;
     TIM17->CCR1 = 0U;
+    TIM3->EGR = TIM_EGR_UG;
     TIM17->EGR = TIM_EGR_UG;
@@ -239,7 +247,17 @@ static void LED_StartAllDma(void) {
