UDP_BIND=0.0.0.0
UDP_PORT=5000
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_RETRY=0.25

GAP_TIMEOUT=0.015
PATH_TIMEOUT=0.20

# Fail-safe: immediately neutralize control, but tolerate normal USB/BT re-enumeration
# before destroying the virtual input device.
NEUTRAL_TIMEOUT=0.20
DISCONNECT_TIMEOUT=5.00

STATS_INTERVAL=10
UINPUT_BIN=/usr/local/bin/uinput
DEVICE_YAML=/etc/controller/dualsense.yaml
NEUTRAL_CONFIG=/etc/controller/neutral.json
