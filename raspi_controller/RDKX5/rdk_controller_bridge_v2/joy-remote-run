#!/usr/bin/env bash
set -euo pipefail

source /opt/ros/humble/setup.bash

ENV_FILE=/etc/default/remote-joy
if [[ -r "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi

exec ros2 run joy joy_node --ros-args \
  -p device_name:="${JOY_DEVICE_NAME:-Remote DualSense}" \
  -p autorepeat_rate:="${JOY_AUTOREPEAT_RATE:-50.0}" \
  -p deadzone:="${JOY_DEADZONE:-0.05}"
