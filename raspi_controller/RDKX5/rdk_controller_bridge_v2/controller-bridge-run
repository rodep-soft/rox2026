#!/usr/bin/env bash
set -euo pipefail

ENV_FILE=/etc/default/controller-bridge
if [[ -r "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi

exec /usr/local/bin/controller-bridge \
  --udp-bind "${UDP_BIND:-0.0.0.0}" \
  --udp-port "${UDP_PORT:-5000}" \
  --rfcomm "${RFCOMM_DEV:-/dev/rfcomm0}" \
  --rfcomm-retry "${RFCOMM_RETRY:-0.25}" \
  --gap-timeout "${GAP_TIMEOUT:-0.015}" \
  --path-timeout "${PATH_TIMEOUT:-0.20}" \
  --neutral-timeout "${NEUTRAL_TIMEOUT:-0.20}" \
  --disconnect-timeout "${DISCONNECT_TIMEOUT:-1.00}" \
  --stats-interval "${STATS_INTERVAL:-10}" \
  --uinput-bin "${UINPUT_BIN:-/usr/local/bin/uinput}" \
  --device-yaml "${DEVICE_YAML:-/etc/controller/dualsense.yaml}" \
  --neutral-config "${NEUTRAL_CONFIG:-/etc/controller/neutral.json}"
