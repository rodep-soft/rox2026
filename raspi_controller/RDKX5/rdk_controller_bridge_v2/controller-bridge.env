# RDK redundant controller bridge settings
UDP_BIND=0.0.0.0
UDP_PORT=5000
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_RETRY=0.25

# Wait briefly for the duplicate copy of an event on the other route.
GAP_TIMEOUT=0.015

# Per-route diagnostic timeout. Does not stop control while the other route lives.
PATH_TIMEOUT=0.20

# Both routes silent for 200 ms -> emit neutral once.
NEUTRAL_TIMEOUT=0.20

# Both routes silent for 1 s -> destroy virtual event device.
DISCONNECT_TIMEOUT=1.00

STATS_INTERVAL=10
UINPUT_BIN=/usr/local/bin/uinput
DEVICE_YAML=/etc/controller/dualsense.yaml
NEUTRAL_CONFIG=/etc/controller/neutral.json
