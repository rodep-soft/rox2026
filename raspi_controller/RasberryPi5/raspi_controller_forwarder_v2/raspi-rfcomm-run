#!/usr/bin/env bash
set -Eeuo pipefail

ENV_FILE=/etc/default/controller-forwarder
# shellcheck disable=SC1090
source "$ENV_FILE"

: "${RDK_BT_MAC:?RDK_BT_MAC is not configured}"
: "${RFCOMM_CHANNEL:=1}"
: "${RFCOMM_DEV:=/dev/rfcomm0}"

if [[ "$RDK_BT_MAC" == "CHANGE_ME" ]]; then
  echo "[raspi-rfcomm-run] RDK_BT_MAC is still CHANGE_ME" >&2
  exit 2
fi

RFCOMM_BIN="$(command -v rfcomm || true)"
if [[ -z "$RFCOMM_BIN" ]]; then
  echo "[raspi-rfcomm-run] rfcomm not found (install bluez)" >&2
  exit 127
fi

# Clean any stale RFCOMM tty left after an unclean shutdown.
RFCOMM_INDEX="${RFCOMM_DEV##*/rfcomm}"
[[ "$RFCOMM_INDEX" =~ ^[0-9]+$ ]] || RFCOMM_INDEX=0
"$RFCOMM_BIN" release "$RFCOMM_INDEX" >/dev/null 2>&1 || true

# -r: raw tty, -A: authentication, -E: encryption.
# This process stays in the foreground while connected. If connection fails or
# drops it exits and systemd restarts it, so boot order does not matter.
exec "$RFCOMM_BIN" -r -A -E -i hci0 connect "$RFCOMM_DEV" "$RDK_BT_MAC" "$RFCOMM_CHANNEL"
