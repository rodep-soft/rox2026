#!/usr/bin/env python3
"""Low-latency redundant evdev sender for RDK controller bridge protocol v2.

Compared with v2, this sender keeps the wire protocol unchanged but reduces
Bluetooth backlog substantially:
  * EV_ABS values are coalesced and emitted at at most --axis-rate (default 100 Hz).
  * EV_KEY transitions are emitted immediately at the next SYN_REPORT.
  * One evdev report is sent as one UDP datagram / one RFCOMM write batch.
  * Heartbeat stays independent (default 20 Hz).
  * A Bluetooth queue item older than --bt-max-latency causes the local writer
    to discard the stale backlog instead of replaying old robot commands.

The RDK v2 receiver already accepts multiple protocol-v2 records in one UDP
datagram and an arbitrary byte stream over RFCOMM, so no RDK protocol change is
required.
"""

from __future__ import annotations

import argparse
import errno
import os
import queue
import secrets
import selectors
import socket
import struct
import sys
import termios
import threading
import time
import tty
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

MAGIC = b"RC"
VERSION = 2
KIND_EVENT = 0
KIND_HEARTBEAT = 1
HEADER = struct.Struct("!2sBBII")
INPUT_EVENT = struct.Struct("@llHHi")
INPUT_EVENT_SIZE = INPUT_EVENT.size
ZERO_EVENT = b"\x00" * INPUT_EVENT_SIZE
UINT32_MASK = 0xFFFFFFFF

EV_SYN = 0x00
EV_KEY = 0x01
EV_ABS = 0x03
SYN_REPORT = 0


def log(msg: str) -> None:
    print(f"[controller-net-sender] {msg}", file=sys.stderr, flush=True)


@dataclass
class Stats:
    events_raw: int = 0
    events_sent: int = 0
    reports_sent: int = 0
    abs_suppressed: int = 0
    syn_suppressed: int = 0
    udp_packets: int = 0
    udp_errors: int = 0
    bt_batches: int = 0
    bt_errors: int = 0
    bt_queue_drops: int = 0
    bt_stale_resets: int = 0
    heartbeats: int = 0


class UdpSender:
    def __init__(self, host: str, port: int, interface: str, stats: Stats) -> None:
        self.host = host
        self.port = port
        self.interface = interface
        self.stats = stats
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setblocking(False)
        if interface:
            try:
                self.sock.setsockopt(
                    socket.SOL_SOCKET,
                    socket.SO_BINDTODEVICE,
                    interface.encode("utf-8") + b"\x00",
                )
                log(f"UDP bound to interface {interface}")
            except (AttributeError, OSError) as e:
                raise RuntimeError(f"failed to bind UDP to interface {interface}: {e}") from e
        self.target: Optional[Tuple[str, int]] = None
        self.next_resolve = 0.0
        self.last_error_log = 0.0

    def _resolve(self, now: float) -> bool:
        if self.target is not None:
            return True
        if now < self.next_resolve:
            return False
        self.next_resolve = now + 1.0
        try:
            infos = socket.getaddrinfo(self.host, self.port, socket.AF_INET, socket.SOCK_DGRAM)
            if not infos:
                raise OSError("no IPv4 address returned")
            address = infos[0][4]
            self.target = (address[0], address[1])
            log(f"UDP target resolved: {self.host}:{self.port} -> {self.target[0]}:{self.target[1]}")
            return True
        except OSError as e:
            if now - self.last_error_log >= 5.0:
                log(f"UDP target resolution failed for {self.host}: {e}")
                self.last_error_log = now
            return False

    def send(self, blob: bytes) -> None:
        if not blob:
            return
        now = time.monotonic()
        if not self._resolve(now):
            return
        assert self.target is not None
        try:
            self.sock.sendto(blob, self.target)
            self.stats.udp_packets += 1
        except (BlockingIOError, OSError) as e:
            self.stats.udp_errors += 1
            if isinstance(e, OSError) and e.errno in (
                errno.ENETUNREACH,
                errno.EHOSTUNREACH,
                errno.ENETDOWN,
                errno.ENODEV,
                errno.EADDRNOTAVAIL,
            ):
                self.target = None
                self.next_resolve = now + 0.5
            if now - self.last_error_log >= 5.0:
                log(f"UDP send error: {e}")
                self.last_error_log = now

    def close(self) -> None:
        self.sock.close()


class BluetoothWriter(threading.Thread):
    """Dedicated RFCOMM writer so Bluetooth cannot stall UDP."""

    def __init__(
        self,
        device: str,
        retry: float,
        queue_size: int,
        max_latency: float,
        stats: Stats,
    ) -> None:
        super().__init__(name="rfcomm-writer", daemon=True)
        self.device = device
        self.retry = retry
        self.max_latency = max_latency
        self.stats = stats
        self.q: queue.Queue[Tuple[float, bytes]] = queue.Queue(maxsize=queue_size)
        self.stop_event = threading.Event()
        self.connected = threading.Event()
        self.reset_event = threading.Event()
        self.fd: Optional[int] = None
        self.last_open_log = 0.0

    def submit(self, blob: bytes) -> None:
        if not blob or not self.connected.is_set():
            return
        try:
            self.q.put_nowait((time.monotonic(), blob))
        except queue.Full:
            # Do not replay a long sequence of stale robot commands.
            self.stats.bt_queue_drops += 1
            self.reset_event.set()

    def stop(self) -> None:
        self.stop_event.set()
        self.reset_event.set()

    def _drain_queue(self) -> None:
        while True:
            try:
                self.q.get_nowait()
            except queue.Empty:
                return

    def _close(self, reason: str = "") -> None:
        fd = self.fd
        self.fd = None
        was_connected = self.connected.is_set()
        self.connected.clear()
        if fd is not None:
            try:
                # Best effort: discard unsent TTY output before closing our fd.
                termios.tcflush(fd, termios.TCOFLUSH)
            except (termios.error, OSError):
                pass
            try:
                os.close(fd)
            except OSError:
                pass
        self._drain_queue()
        if was_connected:
            log(f"Bluetooth RFCOMM writer reset{': ' + reason if reason else ''}")

    def _try_open(self) -> bool:
        now = time.monotonic()
        try:
            fd = os.open(self.device, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
        except FileNotFoundError:
            return False
        except OSError as e:
            if now - self.last_open_log >= 5.0 and e.errno not in (
                errno.ENXIO,
                errno.ENODEV,
                errno.EIO,
                errno.EBUSY,
                errno.EAGAIN,
            ):
                log(f"RFCOMM open error: {e}")
                self.last_open_log = now
            return False

        try:
            tty.setraw(fd, when=termios.TCSANOW)
        except (termios.error, OSError):
            pass
        os.set_blocking(fd, True)
        self.fd = fd
        self.connected.set()
        self.reset_event.clear()
        log(f"Bluetooth RFCOMM writer connected: {self.device}")
        return True

    def _write_all(self, data: bytes) -> None:
        assert self.fd is not None
        view = memoryview(data)
        while view:
            written = os.write(self.fd, view)
            if written <= 0:
                raise OSError(errno.EIO, "zero-length RFCOMM write")
            view = view[written:]

    def run(self) -> None:
        while not self.stop_event.is_set():
            if self.reset_event.is_set():
                self._close("queue overflow")
                self.reset_event.clear()

            if self.fd is None:
                if not self._try_open():
                    self.stop_event.wait(self.retry)
                    continue

            try:
                queued_at, blob = self.q.get(timeout=0.1)
            except queue.Empty:
                continue

            age = time.monotonic() - queued_at
            if age > self.max_latency:
                self.stats.bt_stale_resets += 1
                self._close(f"stale backlog {age * 1000:.0f} ms")
                self.stop_event.wait(self.retry)
                continue

            try:
                self._write_all(blob)
                self.stats.bt_batches += 1
            except OSError as e:
                self.stats.bt_errors += 1
                self._close(str(e))
                self.stop_event.wait(self.retry)

        self._close("shutdown")


class Sender:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.stats = Stats()
        self.session_id = secrets.randbits(32)
        self.seq = 0
        self.stdin_fd = sys.stdin.buffer.fileno()
        self.stdin_buffer = bytearray()
        self.selector = selectors.DefaultSelector()
        self.selector.register(self.stdin_fd, selectors.EVENT_READ)
        self.udp = UdpSender(args.rdk_host, args.udp_port, args.wifi_interface, self.stats)
        self.bt = BluetoothWriter(
            args.rfcomm,
            args.rfcomm_retry,
            args.bt_queue_size,
            args.bt_max_latency,
            self.stats,
        )
        now = time.monotonic()
        self.next_heartbeat = now
        self.next_stats = now + args.stats_interval
        self.next_axis_flush = now

        # Latest value actually sent to the RDK for each ABS axis.
        self.last_abs_sent: Dict[int, int] = {}
        # Latest ABS event waiting for the next <= axis-rate flush.
        self.pending_abs: Dict[int, bytes] = {}
        # Buttons and uncommon events are urgent and are flushed at the next SYN_REPORT.
        self.pending_urgent: List[bytes] = []

    def _record(self, kind: int, seq: int, payload: bytes) -> bytes:
        return HEADER.pack(MAGIC, VERSION, kind, self.session_id, seq) + payload

    def _send_blob(self, blob: bytes) -> None:
        self.udp.send(blob)
        self.bt.submit(blob)

    def _send_heartbeat(self, now: float) -> None:
        self._send_blob(self._record(KIND_HEARTBEAT, self.seq, ZERO_EVENT))
        self.stats.heartbeats += 1
        self.next_heartbeat = now + self.args.heartbeat_interval

    def _send_event_batch(self, payloads: List[bytes]) -> None:
        if not payloads:
            return
        parts: List[bytes] = []
        for payload in payloads:
            parts.append(self._record(KIND_EVENT, self.seq, payload))
            self.seq = (self.seq + 1) & UINT32_MASK
        self._send_blob(b"".join(parts))
        self.stats.events_sent += len(payloads)
        self.stats.reports_sent += 1

    def _queue_event(self, payload: bytes) -> None:
        _sec, _usec, ev_type, code, value = INPUT_EVENT.unpack(payload)
        self.stats.events_raw += 1

        if ev_type == EV_ABS:
            last = self.last_abs_sent.get(code)
            # Hat/D-pad axes use only -1/0/+1, so never apply the analog
            # deadband to ABS_HAT0X..ABS_HAT3Y (0x10..0x17).
            min_delta = 0 if 0x10 <= code <= 0x17 else self.args.abs_min_delta
            if last is not None and abs(value - last) <= min_delta:
                # If an earlier value for this axis was pending, returning close to the
                # last transmitted state means there is no net state change to send.
                self.pending_abs.pop(code, None)
                self.stats.abs_suppressed += 1
                return
            self.pending_abs[code] = payload
            return

        if ev_type == EV_SYN and code == SYN_REPORT:
            self._finish_report(payload)
            return

        # Button transitions must not wait for the axis-rate timer.
        # Other rare event types follow the same safe/urgent path.
        self.pending_urgent.append(payload)

    def _finish_report(self, syn_payload: bytes) -> None:
        now = time.monotonic()
        urgent = bool(self.pending_urgent)
        axis_due = now >= self.next_axis_flush

        if not urgent and (not self.pending_abs or not axis_due):
            self.stats.syn_suppressed += 1
            return

        payloads: List[bytes] = []
        if self.pending_urgent:
            payloads.extend(self.pending_urgent)
            self.pending_urgent.clear()

        if self.pending_abs and (urgent or axis_due):
            # Dict preserves first-seen axis order while values are replaced with
            # the newest event in the current coalescing window.
            for code, payload in self.pending_abs.items():
                _sec, _usec, _type, _code, value = INPUT_EVENT.unpack(payload)
                self.last_abs_sent[code] = value
                payloads.append(payload)
            self.pending_abs.clear()
            self.next_axis_flush = now + (1.0 / self.args.axis_rate)

        if payloads:
            payloads.append(syn_payload)
            self._send_event_batch(payloads)
        else:
            self.stats.syn_suppressed += 1

    def _read_stdin(self) -> bool:
        try:
            chunk = os.read(self.stdin_fd, 8192)
        except InterruptedError:
            return True
        if not chunk:
            return False
        self.stdin_buffer.extend(chunk)
        while len(self.stdin_buffer) >= INPUT_EVENT_SIZE:
            payload = bytes(self.stdin_buffer[:INPUT_EVENT_SIZE])
            del self.stdin_buffer[:INPUT_EVENT_SIZE]
            self._queue_event(payload)
        return True

    def _log_stats(self, now: float) -> None:
        if now < self.next_stats:
            return
        self.next_stats = now + self.args.stats_interval
        s = self.stats
        reduction = 0.0
        if s.events_raw:
            reduction = 100.0 * (1.0 - (s.events_sent / s.events_raw))
        log(
            f"stats session=0x{self.session_id:08x} seq={self.seq} "
            f"raw={s.events_raw} sent={s.events_sent} reduction={reduction:.1f}% "
            f"reports={s.reports_sent} hb={s.heartbeats} "
            f"udp_pkt={s.udp_packets}/{s.udp_errors} "
            f"bt_batch={s.bt_batches}/{s.bt_errors} bt_connected={self.bt.connected.is_set()} "
            f"bt_qdrop={s.bt_queue_drops} bt_stale={s.bt_stale_resets}"
        )

    def run(self) -> int:
        log(
            f"start session=0x{self.session_id:08x}, protocol=v{VERSION}, "
            f"input_event={INPUT_EVENT_SIZE}B, record={HEADER.size + INPUT_EVENT_SIZE}B, "
            f"UDP={self.args.rdk_host}:{self.args.udp_port}, RFCOMM={self.args.rfcomm}, "
            f"heartbeat={self.args.heartbeat_interval * 1000:.0f}ms, "
            f"axis_rate={self.args.axis_rate:.0f}Hz, abs_min_delta={self.args.abs_min_delta}, "
            f"bt_max_latency={self.args.bt_max_latency * 1000:.0f}ms"
        )
        self.bt.start()
        self._send_heartbeat(time.monotonic())

        try:
            while True:
                now = time.monotonic()
                timeout = max(0.0, min(self.next_heartbeat - now, 0.05))
                events = self.selector.select(timeout=timeout)
                if events and not self._read_stdin():
                    if self.stdin_buffer:
                        log(f"stdin EOF with {len(self.stdin_buffer)} trailing byte(s); dropping partial event")
                    log("controller input stream closed; stopping heartbeat and sender")
                    return 0

                now = time.monotonic()
                if now >= self.next_heartbeat:
                    self._send_heartbeat(now)
                self._log_stats(now)
        finally:
            self.bt.stop()
            self.bt.join(timeout=0.5)
            self.udp.close()
            try:
                self.selector.unregister(self.stdin_fd)
            except Exception:
                pass
            self.selector.close()


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Low-latency redundant evdev sender for RDK bridge v2")
    p.add_argument("--rdk-host", required=True)
    p.add_argument("--udp-port", type=int, default=5000)
    p.add_argument("--wifi-interface", default="wlan0")
    p.add_argument("--rfcomm", default="/dev/rfcomm0")
    p.add_argument("--rfcomm-retry", type=float, default=0.20)
    p.add_argument("--heartbeat-interval", type=float, default=0.05)
    p.add_argument("--bt-queue-size", type=int, default=16)
    p.add_argument("--bt-max-latency", type=float, default=0.10,
                   help="discard/reset RFCOMM writer if queued data is older than this many seconds")
    p.add_argument("--axis-rate", type=float, default=100.0,
                   help="maximum EV_ABS transmission report rate")
    p.add_argument("--abs-min-delta", type=int, default=1,
                   help="suppress EV_ABS changes <= this many raw counts from last sent value")
    p.add_argument("--stats-interval", type=float, default=10.0)
    return p.parse_args()


def validate(args: argparse.Namespace) -> None:
    if INPUT_EVENT_SIZE != 24:
        raise RuntimeError(
            f"native struct input_event is {INPUT_EVENT_SIZE} bytes, expected 24. "
            "Raspberry Pi and RDK must use the same 64-bit Linux input ABI."
        )
    if not 1 <= args.udp_port <= 65535:
        raise ValueError("udp-port must be 1..65535")
    if args.heartbeat_interval <= 0 or args.rfcomm_retry <= 0 or args.stats_interval <= 0:
        raise ValueError("intervals must be > 0")
    if args.bt_queue_size < 1:
        raise ValueError("bt-queue-size must be >= 1")
    if args.bt_max_latency <= 0:
        raise ValueError("bt-max-latency must be > 0")
    if not 1 <= args.axis_rate <= 1000:
        raise ValueError("axis-rate must be 1..1000 Hz")
    if args.abs_min_delta < 0:
        raise ValueError("abs-min-delta must be >= 0")


def main() -> int:
    args = parse_args()
    try:
        validate(args)
        return Sender(args).run()
    except KeyboardInterrupt:
        return 130
    except Exception as e:
        log(f"FATAL: {type(e).__name__}: {e}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
