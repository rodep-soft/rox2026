# Raspberry Pi -> RDK redundant controller forwarding settings.
# Edit RDK_HOST and RDK_BT_MAC before enabling services.

# RDK Wi-Fi IPv4 address is recommended for deterministic robot operation.
# Example: 10.82.0.120
RDK_HOST=CHANGE_ME
UDP_PORT=5000

# Force UDP packets out the Wi-Fi interface so the two paths remain independent.
# Set empty (WIFI_INTERFACE=) to let Linux routing choose.
WIFI_INTERFACE=wlan0

# RDK Bluetooth controller MAC address.
# Example: 18:CE:DF:78:B6:FA
RDK_BT_MAC=CHANGE_ME
RFCOMM_CHANNEL=1
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_RETRY=0.20

# Send heartbeat on both paths while the real controller event stream exists.
# RDK v2 is configured for neutral at 0.20 s and disconnect at 1.00 s.
HEARTBEAT_INTERVAL=0.05

# Interception Tools: 1 grabs the gamepad exclusively on the Pi.
# For a dedicated transmitter Pi this is recommended.
GRAB_DEVICE=1

# Sender diagnostics
STATS_INTERVAL=10
BT_QUEUE_SIZE=256
