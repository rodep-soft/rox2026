#!/usr/bin/env bash
set -Eeuo pipefail

CONF=/etc/interception/dualsense-forwarder.yaml
UDEVMON_BIN="$(command -v udevmon || true)"
if [[ -z "$UDEVMON_BIN" ]]; then
  echo "[controller-udevmon-run] udevmon not found" >&2
  exit 127
fi
if [[ ! -r "$CONF" ]]; then
  echo "[controller-udevmon-run] missing $CONF" >&2
  exit 2
fi
exec "$UDEVMON_BIN" -c "$CONF"
