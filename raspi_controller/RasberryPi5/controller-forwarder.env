# Final Raspberry Pi -> RDK redundant controller forwarding settings.
RDK_HOST=10.42.0.251
UDP_PORT=5000
WIFI_INTERFACE=wlan0

RDK_BT_MAC=18:CE:DF:78:E6:56
RFCOMM_CHANNEL=1
RFCOMM_DEV=/dev/rfcomm0
RFCOMM_RETRY=0.20

# 20 Hz liveness heartbeat. Independent from controller movement.
HEARTBEAT_INTERVAL=0.05

# Dedicated transmitter Pi: grab the physical joystick evdev node exclusively.
GRAB_DEVICE=1

STATS_INTERVAL=10

# Final tuned Bluetooth/axis settings.
BT_QUEUE_SIZE=8
AXIS_RATE=120
ABS_MIN_DELTA=1
BT_MAX_LATENCY=0.03
